@model List<TicketWeb.Models.Ticket>
@{
    ViewData["Title"] = "Tickets";
}

<h1>Tickets</h1>
<a asp-action="Create" class="btn btn-primary mb-3">Add ticket</a>
<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Title</th>
            <th>Users</th>
            <th>Priority</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ticket in Model)
        {
            <tr>
                <td>@ticket.Id</td>
                <td>@ticket.Title</td>
                <td>@ticket.UsersAffected</td>
                <td>@ticket.Priority</td>
                <td>@ticket.Status</td>
                <td>
                    @if (ticket.Status != TicketStatus.Closed)
                    {
                        <form asp-action="Close" method="post">
                            <input type="hidden" name="id" value="@ticket.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Close</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>

</table>
